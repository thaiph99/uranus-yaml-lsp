{
  "name": "uranus-yaml",
  "displayName": "Uranus YAML LSP",
  "description": "Argo Workflow YAML navigation for WorkflowTemplate definitions and references.",
  "version": "1.0.2",
  "publisher": "ThaiPham",
  "author": {
    "name": "Thai Pham"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaiph99/uranus-yaml-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/thaiph99/uranus-yaml-lsp/issues"
  },
  "homepage": "https://github.com/thaiph99/uranus-yaml-lsp#readme",
  "keywords": [
    "yaml",
    "argo",
    "workflow",
    "template",
    "navigation",
    "go-to-definition",
    "kubernetes",
    "devops"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yaml",
        "aliases": [
          "YAML"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:core && npm run compile && npm run bundle:core",
    "build:core": "npm --prefix ../core run build",
    "bundle:core": "node scripts/bundleCoreDependency.js",
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "package": "vsce package",
    "clean": "rimraf out"
  },
  "dependencies": {},
  "devDependencies": {
    "@uranus-yaml/core": "^0.0.1",
    "@vscode/vsce": "^3.0.0",
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0"
  }
}
