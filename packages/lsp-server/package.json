{
  "name": "@uranus-yaml/lsp-server",
  "version": "0.0.2",
  "description": "Language Server Protocol server for Argo Workflow YAML navigation",
  "main": "./dist/server.js",
  "bin": {
    "uranus-yaml-lsp": "./bin/uranus-yaml-lsp"
  },
  "scripts": {
    "build:core": "npm --prefix ../core run build",
    "bundle:core": "node scripts/bundleCoreDependency.js",
    "compile": "tsc",
    "build": "npm run build:core && npm run compile && npm run bundle:core",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "watch": "tsc -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.8"
  },
  "devDependencies": {
    "@uranus-yaml/core": "^0.0.2",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0",
    "@types/node": "^18.0.0"
  },
  "files": [
    "dist",
    "bin"
  ]
}
