{
  "name": "uranus-yaml-workspace",
  "version": "0.0.1",
  "description": "Argo Workflow YAML navigation for VS Code and Language Server Protocol clients",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "watch": "npm run watch --workspaces",
    "test": "npm run build:core && npm run test -w packages/core",
    "build:core": "npm run build -w packages/core",
    "build:lsp": "npm run build -w packages/lsp-server",
    "build:vscode": "npm run build -w packages/vscode-extension",
    "install:all": "npm install && npm install --workspaces",
    "package:vscode": "cd packages/vscode-extension && vsce package",
    "package:lsp": "cd packages/lsp-server && npm pack"
  },
  "devDependencies": {
    "rimraf": "^5.0.0"
  }
}
